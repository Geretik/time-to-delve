# Postgres. Locally: docker compose up -d (see docker-compose.yml).
# On Vercel this is filled in by the Neon integration.
DATABASE_URL=postgres://ttd:ttd@localhost:54329/ttd

# Optional: shared registration code. Without it, registration works only via
# e-mail invitations (page "Tým") – or for the very first account.
INVITE_CODE=

# E-mails (invitations, password reset) via https://resend.com
# Without RESEND_API_KEY e-mails are only printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="Time to Delve <ttd@doupeol.cz>"

# Base URL for links in e-mails. On Vercel the production URL is detected automatically.
APP_URL=http://localhost:3000

# Only when self-hosting behind a reverse proxy (not on Vercel): how many proxies stand
# in front of the app and add the caller's address to X-Forwarded-For. Without it the
# caller's address can't be trusted and the per-address rate limits are switched off.
TRUSTED_PROXIES=
